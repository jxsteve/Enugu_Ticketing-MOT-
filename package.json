{
  "name": "enugu-mot-ticketing",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm -w client run dev",
    "dev:server": "npm -w server run dev",
    "build": "npm -w client run build && npm -w server run build",
    "typecheck": "npm -w client run typecheck && npm -w server run typecheck"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
